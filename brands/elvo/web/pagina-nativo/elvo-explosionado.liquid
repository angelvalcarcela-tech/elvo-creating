{%- assign foto = section.settings.imagen -%}
<style>
.ex{max-width:1440px;margin:0 auto;padding:12px;font-family:'Inter',Arial,sans-serif;color:#050607}
.ex__bg{border-radius:24px;padding:clamp(24px,4vw,56px);background-color:#F3F5F7;background-image:linear-gradient(rgba(107,116,128,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(107,116,128,.09) 1px,transparent 1px);background-size:40px 40px}
.ex__head{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#4A5258;margin-bottom:28px}
.ex__head b{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600}
.ex h2{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:clamp(1.8rem,3.2vw,2.8rem);letter-spacing:-.02em;line-height:1.05;margin:0 0 8px}
.ex__lead{font-size:16px;line-height:1.5;color:#5B6470;margin:0 0 30px;max-width:56ch}
.ex__body{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,72px);align-items:center}
.ex__fig{max-width:460px;width:100%;margin:0 auto}
.ex__fig svg,.ex__fig img{width:100%;height:auto;display:block}
.ex__list{list-style:none;margin:0;padding:0}
.ex__list li{display:grid;grid-template-columns:48px 1fr;gap:4px 12px;padding:16px 0;border-bottom:1px solid rgba(107,116,128,.25)}
.ex__list li:first-child{border-top:1px solid rgba(107,116,128,.25)}
.ex__list b{grid-row:span 2;font-family:'Plus Jakarta Sans',Arial,sans-serif;font-size:1.35rem;font-weight:700}
.ex__list .n{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:#050607}
.ex__list .t{font-size:14.5px;color:#5B6470;line-height:1.45}
.ex__fine{font-size:12px;color:#6B7480;margin:20px 0 0}
@media(max-width:800px){.ex{padding:10px}.ex__body{grid-template-columns:1fr}.ex__fig{max-width:340px}}
</style>
<section class="ex" id="nucleo">
 <div class="ex__bg">
  <div class="ex__head"><b>[ {{ section.settings.producto }} ]</b><span>[ {{ section.settings.subtitulo }} ]</span></div>
  <h2>{{ section.settings.titulo }}</h2>
  <p class="ex__lead">{{ section.settings.bajada }}</p>
  <div class="ex__body">
   <div class="ex__fig">{%- if foto != blank -%}{{ foto | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.titulo }}{%- else -%}<svg viewBox="0 0 420 560" role="img" aria-label="Diagrama explosionado de las seis etapas del núcleo"><defs><pattern id="exh" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0V6" stroke="#9AA4AD" stroke-width="1"/></pattern><pattern id="exd" width="8" height="8" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1" fill="#7C8791"/></pattern><linearGradient id="exg" x1="0" x2="1"><stop offset="0" stop-color="#000" stop-opacity=".12"/><stop offset=".5" stop-color="#fff" stop-opacity=".25"/><stop offset="1" stop-color="#000" stop-opacity=".14"/></linearGradient></defs><path d="M210 8V552" stroke="#3355FF" stroke-width="1.5" stroke-dasharray="3 5"/><g><ellipse cx="210" cy="70" rx="104" ry="16" fill="#2B3238" stroke="#7C8791" stroke-width=".8"/><rect x="106" y="26" width="208" height="44" fill="#2B3238"/><rect x="106" y="26" width="208" height="44" fill="url(#exg)"/><path d="M106 26V70M314 26V70" stroke="#7C8791" stroke-width=".8"/><ellipse cx="210" cy="26" rx="104" ry="16" fill="#2B3238" stroke="#7C8791" stroke-width=".8"/><ellipse cx="210" cy="26" rx="104" ry="16" fill="url(#exg)"/></g><path d="M322 48H372" stroke="#6B7480" stroke-width="1"/><circle cx="322" cy="48" r="3" fill="#6B7480"/><text x="380" y="53" font-size="15" font-weight="700" fill="#050607" font-family="Plus Jakarta Sans,Arial,sans-serif">01</text><g><ellipse cx="210" cy="156" rx="104" ry="16" fill="#AEB6BD" stroke="#7C8791" stroke-width=".8"/><rect x="106" y="112" width="208" height="44" fill="#AEB6BD"/><rect x="106" y="112" width="208" height="44" fill="url(#exg)"/><path d="M106 112V156M314 112V156" stroke="#7C8791" stroke-width=".8"/><ellipse cx="210" cy="112" rx="104" ry="16" fill="#AEB6BD" stroke="#7C8791" stroke-width=".8"/><ellipse cx="210" cy="112" rx="104" ry="16" fill="url(#exg)"/></g><path d="M322 134H372" stroke="#6B7480" stroke-width="1"/><circle cx="322" cy="134" r="3" fill="#6B7480"/><text x="380" y="139" font-size="15" font-weight="700" fill="#050607" font-family="Plus Jakarta Sans,Arial,sans-serif">02</text><g><ellipse cx="210" cy="242" rx="104" ry="16" fill="#C9D0D6" stroke="#7C8791" stroke-width=".8"/><rect x="106" y="198" width="208" height="44" fill="#C9D0D6"/><rect x="106" y="198" width="208" height="44" fill="url(#exd)" opacity=".7"/><rect x="106" y="198" width="208" height="44" fill="url(#exg)"/><path d="M106 198V242M314 198V242" stroke="#7C8791" stroke-width=".8"/><ellipse cx="210" cy="198" rx="104" ry="16" fill="#C9D0D6" stroke="#7C8791" stroke-width=".8"/><ellipse cx="210" cy="198" rx="104" ry="16" fill="url(#exg)"/></g><path d="M322 220H372" stroke="#6B7480" stroke-width="1"/><circle cx="322" cy="220" r="3" fill="#6B7480"/><text x="380" y="225" font-size="15" font-weight="700" fill="#050607" font-family="Plus Jakarta Sans,Arial,sans-serif">03</text><g><ellipse cx="210" cy="328" rx="104" ry="16" fill="#E4E8EB" stroke="#7C8791" stroke-width=".8"/><rect x="106" y="284" width="208" height="44" fill="#E4E8EB"/><rect x="106" y="284" width="208" height="44" fill="url(#exh)" opacity=".6"/><rect x="106" y="284" width="208" height="44" fill="url(#exg)"/><path d="M106 284V328M314 284V328" stroke="#7C8791" stroke-width=".8"/><ellipse cx="210" cy="284" rx="104" ry="16" fill="#E4E8EB" stroke="#7C8791" stroke-width=".8"/><ellipse cx="210" cy="284" rx="104" ry="16" fill="url(#exg)"/></g><path d="M322 306H372" stroke="#6B7480" stroke-width="1"/><circle cx="322" cy="306" r="3" fill="#6B7480"/><text x="380" y="311" font-size="15" font-weight="700" fill="#050607" font-family="Plus Jakarta Sans,Arial,sans-serif">04</text><g><ellipse cx="210" cy="414" rx="104" ry="16" fill="#D5DCE2" stroke="#7C8791" stroke-width=".8"/><rect x="106" y="370" width="208" height="44" fill="#D5DCE2"/><rect x="106" y="370" width="208" height="44" fill="url(#exg)"/><path d="M106 370V414M314 370V414" stroke="#7C8791" stroke-width=".8"/><ellipse cx="210" cy="370" rx="104" ry="16" fill="#D5DCE2" stroke="#7C8791" stroke-width=".8"/><ellipse cx="210" cy="370" rx="104" ry="16" fill="url(#exg)"/></g><path d="M322 392H372" stroke="#6B7480" stroke-width="1"/><circle cx="322" cy="392" r="3" fill="#6B7480"/><text x="380" y="397" font-size="15" font-weight="700" fill="#050607" font-family="Plus Jakarta Sans,Arial,sans-serif">05</text><g><ellipse cx="210" cy="500" rx="104" ry="16" fill="#F4F6F8" stroke="#7C8791" stroke-width=".8"/><rect x="106" y="456" width="208" height="44" fill="#F4F6F8"/><rect x="106" y="456" width="208" height="44" fill="url(#exg)"/><path d="M106 456V500M314 456V500" stroke="#7C8791" stroke-width=".8"/><ellipse cx="210" cy="456" rx="104" ry="16" fill="#F4F6F8" stroke="#7C8791" stroke-width=".8"/><ellipse cx="210" cy="456" rx="104" ry="16" fill="url(#exg)"/></g><path d="M322 478H372" stroke="#6B7480" stroke-width="1"/><circle cx="322" cy="478" r="3" fill="#6B7480"/><text x="380" y="483" font-size="15" font-weight="700" fill="#050607" font-family="Plus Jakarta Sans,Arial,sans-serif">06</text><path d="M204 540l6 10 6-10" fill="#3355FF"/></svg>{%- endif -%}</div>
   <ol class="ex__list">{%- for b in section.blocks -%}<li {{ b.shopify_attributes }}><b>{{ forloop.index | prepend: '0' }}</b><span class="n">[ {{ b.settings.nombre }} ]</span><span class="t">{{ b.settings.texto }}</span></li>{%- endfor -%}</ol>
  </div>
  <p class="ex__fine">{{ section.settings.legal }}</p>
 </div>
</section>
{% schema %}
{"name":"elvo· Núcleo explosionado","settings":[
{"type":"image_picker","id":"imagen","label":"Imagen del núcleo explosionado (opcional)","info":"Sin imagen se muestra un diagrama dibujado."},
{"type":"text","id":"producto","label":"Producto","default":"elvo· Nativo"},
{"type":"text","id":"subtitulo","label":"Subtítulo","default":"Núcleo PureCore · corte explosionado"},
{"type":"text","id":"titulo","label":"Título","default":"Seis etapas, un solo núcleo"},
{"type":"textarea","id":"bajada","label":"Bajada","default":"Así pasa el agua por dentro del núcleo, de arriba hacia abajo."},
{"type":"text","id":"legal","label":"Nota","default":"*Según la ficha técnica del núcleo PureCore. Diagrama ilustrativo: el orden y el espesor de cada etapa son representativos."}],
"blocks":[{"type":"etapa","name":"Etapa","settings":[{"type":"text","id":"nombre","label":"Nombre","default":"Etapa"},{"type":"text","id":"texto","label":"Texto","default":"Descripción"}]}],
"max_blocks":8,
"presets":[{"name":"elvo· Núcleo explosionado","blocks":[
{"type":"etapa","settings":{"nombre":"Carbón activado","texto":"Reduce cloro, olores y sabores."}},
{"type":"etapa","settings":{"nombre":"KDF-F","texto":"Retiene plomo y metales pesados*."}},
{"type":"etapa","settings":{"nombre":"Nanotecnología","texto":"Etapa adicional del núcleo PureCore."}},
{"type":"etapa","settings":{"nombre":"Aluminosilicato sintético","texto":"Cuida la calidad del agua."}},
{"type":"etapa","settings":{"nombre":"Plata coloidal","texto":"Protege el núcleo por dentro."}},
{"type":"etapa","settings":{"nombre":"Plata iónica","texto":"Protege el núcleo por dentro."}}]}]}
{% endschema %}
