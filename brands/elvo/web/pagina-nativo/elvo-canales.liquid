<style>
.ek{max-width:1100px;margin:0 auto;padding:56px 24px;font-family:'Inter',Arial,sans-serif;color:#050607}
.ek__k{font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:#3355FF}
.ek h2{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:clamp(27.2px,3vw,41.6px);letter-spacing:-.02em;line-height:1.08;margin:10px 0 10px}
.ek__l{font-size:16px;line-height:1.5;color:#5B6470;margin:0 0 24px;max-width:60ch}
.ek__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.ek__t{display:flex;align-items:center;justify-content:center;gap:8px;min-height:76px;padding:12px 14px;border:1px solid #DCE6EE;border-radius:18px;background:#fff;text-decoration:none;color:#050607;transition:border-color .2s,box-shadow .2s}
.ek__t:hover,.ek__t:focus-visible{border-color:#3355FF;box-shadow:0 0 0 1px #3355FF}
.ek__t img{height:30px;width:auto;max-width:130px;object-fit:contain;display:block}
.ek__t b{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:17px;letter-spacing:-.01em}
.ek__w{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:700;font-size:26px;letter-spacing:-.04em;line-height:1}
.ek__w small{font-size:14px;font-weight:500;letter-spacing:0;color:#6B7480;margin-left:2px}
.ek__f{font-size:13px;color:#6B7480;margin:18px 0 0;line-height:1.5}
@media(max-width:700px){.ek{padding:40px 16px}.ek__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.ek__t{min-height:68px}}
</style>
<section class="ek" id="canales">
  <span class="ek__k">{{ section.settings.etiqueta }}</span>
  <h2>{{ section.settings.titulo }}</h2>
  <p class="ek__l">{{ section.settings.bajada }}</p>
  <div class="ek__grid">
    <a class="ek__t" href="{{ section.settings.url_web | default: '/products/elvonativo' }}" aria-label="Comprar en elvo.pe"><span class="ek__w">elvo·<small>.pe</small></span></a>
    <a class="ek__t" target="_blank" rel="noopener" href="https://wa.me/51929190100?text=Hola,%20quiero%20comprar%20elvo%C2%B7%20%5BWEB-HOME%5D" aria-label="Escribir por WhatsApp"><svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#25D366"/><path fill="#fff" d="M12 4.5a7.5 7.5 0 0 0-6.4 11.3L4.5 19.5l3.8-1A7.5 7.5 0 1 0 12 4.5zm4 10.4c-.2.5-1 .9-1.4.9-.4.1-.8.1-2.5-.5-2.1-.9-3.4-3-3.5-3.1-.1-.2-.8-1.1-.8-2.1s.5-1.5.7-1.7c.2-.2.4-.2.5-.2h.4c.1 0 .3 0 .4.4l.6 1.4c.1.1.1.3 0 .4l-.3.5c-.1.1-.2.3-.1.5.2.3.6 1 1.3 1.6.9.8 1.6 1 1.8 1.1.2.1.4.1.5-.1l.7-.8c.1-.2.3-.2.5-.1l1.4.7c.2.1.3.2.3.3.1.1.1.6-.1 1z"/></svg><b>WhatsApp</b></a>
    <a class="ek__t" target="_blank" rel="noopener" href="https://www.instagram.com/elvo_filtros/" aria-label="Ver Instagram"><svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><defs><linearGradient id="ekig" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#FEDA75"/><stop offset=".35" stop-color="#FA7E1E"/><stop offset=".6" stop-color="#D62976"/><stop offset="1" stop-color="#4F5BD5"/></linearGradient></defs><rect width="24" height="24" rx="6" fill="url(#ekig)"/><rect x="5.5" y="5.5" width="13" height="13" rx="4" fill="none" stroke="#fff" stroke-width="1.6"/><circle cx="12" cy="12" r="3.1" fill="none" stroke="#fff" stroke-width="1.6"/><circle cx="16" cy="8" r="1" fill="#fff"/></svg><b>Instagram</b></a>
    <a class="ek__t" target="_blank" rel="noopener" href="https://www.falabella.com.pe/falabella-pe/seller/IMPORTACIONES%20GAD" aria-label="Comprar en Falabella"><img src="{{ 'elvo-logo-falabella.svg' | file_url }}" alt="Falabella" loading="lazy"></a>
    <a class="ek__t" target="_blank" rel="noopener" href="https://www.sodimac.com.pe/sodimac-pe/vendedor/IMPORTACIONES%20GAD" aria-label="Comprar en Sodimac"><img src="{{ 'elvo-logo-sodimac.svg' | file_url }}" alt="Sodimac" loading="lazy"></a>
    <a class="ek__t" target="_blank" rel="noopener" href="https://www.plazavea.com.pe/sellers?id=ELVO" aria-label="Comprar en Plaza Vea"><img src="{{ 'elvo-logo-plazavea.svg' | file_url }}" alt="Plaza Vea" loading="lazy"></a>
    <a class="ek__t" target="_blank" rel="noopener" href="https://www.promart.pe/gasfiteria/purificadores-de-agua-y-filtros/repuestos-de-purificadores-y-filtros/elvo" aria-label="Comprar en Promart"><img src="{{ 'elvo-logo-promart.png' | file_url }}" alt="Promart" loading="lazy"></a>
    <a class="ek__t" target="_blank" rel="noopener" href="https://www.oechsle.pe/mejoramiento-del-hogar/gasfiteria/filtros-y-purificadores/elvo" aria-label="Comprar en Oechsle"><img src="{{ 'elvo-logo-oechsle.svg' | file_url }}" alt="Oechsle" loading="lazy"></a>
  </div>
  <p class="ek__f">{{ section.settings.pie }}</p>
</section>
{% schema %}
{"name":"elvo· Canales","settings":[
{"type":"text","id":"etiqueta","label":"Etiqueta","default":"Dónde comprar"},
{"type":"text","id":"titulo","label":"Título","default":"Estamos en todos los canales"},
{"type":"textarea","id":"bajada","label":"Bajada","default":"Compra donde te quede más cómodo: en la web, por WhatsApp o en las principales tiendas online del Perú."},
{"type":"url","id":"url_web","label":"Enlace de la tienda web (vacío = ficha de Nativo)"},
{"type":"text","id":"pie","label":"Pie","default":"Recojo gratis en nuestro almacen en Jr. Quilca 565, Breña, de lunes a viernes de 9 a. m. a 5 p. m."}],
"presets":[{"name":"elvo· Canales"}]}
{% endschema %}
