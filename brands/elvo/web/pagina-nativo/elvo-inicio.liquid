{%- assign fallback = 'elvo-nativo-front.png' | file_url -%}
{%- assign foto = section.settings.imagen -%}
<style>
.ho{background:#F5F5F7;text-align:center;font-family:'Inter',Arial,sans-serif;color:#050607;overflow:hidden}
.ho *{box-sizing:border-box}
.ho__in{max-width:1100px;margin:0 auto;padding:40px 20px 0}
.ho h1{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:clamp(36px,6vw,76px);line-height:1.03;letter-spacing:-.025em;text-transform:uppercase;margin:0}
.ho__sub{font-size:clamp(17px,1.8vw,22px);line-height:1.4;color:#2B3238;margin:14px auto 0;max-width:34ch}
.ho__row{display:flex;gap:10px 24px;align-items:center;justify-content:center;flex-wrap:wrap;margin-top:22px}
.ho__pill{background:#3355FF;color:#fff;border-radius:999px;padding:14px 28px;font-weight:600;font-size:16px;text-decoration:none;transition:background .2s}
.ho__pill:hover{background:#050607}
.ho__ln{color:#3355FF;font-size:16px;text-decoration:none;padding:12px 4px}
.ho__img{display:block;margin:14px auto 0;width:min(100%,640px);height:clamp(300px,50vh,560px);object-fit:contain;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent),linear-gradient(180deg,transparent,#000 5%,#000 95%,transparent);-webkit-mask-composite:source-in;mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent),linear-gradient(180deg,transparent,#000 5%,#000 95%,transparent);mask-composite:intersect}
@media(max-width:700px){.ho__in{padding:32px 16px 0}.ho__img{height:clamp(300px,46vh,420px);margin-top:8px}}
</style>
<section class="ho">
 <div class="ho__in">
  <h1>{{ section.settings.titular }}</h1>
  <p class="ho__sub">{{ section.settings.sub }}</p>
  <div class="ho__row"><a class="ho__pill" href="{{ section.settings.url | default: '/products/elvonativo' }}">{{ section.settings.cta }}</a><a class="ho__ln" href="#recorrido">{{ section.settings.enlace }} ↓</a></div>
 </div>
 {%- if foto != blank -%}{{ foto | image_url: width: 1254 | image_tag: class: 'ho__img', loading: 'eager', fetchpriority: 'high', alt: 'elvo· Nativo, purificador para el caño' }}{%- else -%}<img class="ho__img" src="{{ fallback }}" alt="elvo· Nativo, purificador para el caño">{%- endif -%}
</section>
{% schema %}
{"name": "elvo· Inicio", "settings": [{"type": "image_picker", "id": "imagen", "label": "Foto del producto (fondo claro #F5F5F7)", "info": "Sin foto se usa la de producto."}, {"type": "text", "id": "titular", "label": "Titular", "default": "El agua es el primer ingrediente."}, {"type": "textarea", "id": "sub", "label": "Bajada", "default": "Filtrar no es plomería: es cuidar lo primero que bebes."}, {"type": "text", "id": "cta", "label": "Botón", "default": "Conoce Nativo"}, {"type": "url", "id": "url", "label": "Enlace del botón (vacío = ficha de Nativo)"}, {"type": "text", "id": "enlace", "label": "Enlace secundario", "default": "Cómo funciona"}, {"type": "text", "id": "pie", "label": "(Sin uso) Pie", "default": "Diseñado para el día a día"}], "presets": [{"name": "elvo· Inicio"}]}
{% endschema %}
