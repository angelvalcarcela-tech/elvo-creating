{{ 'elvo-web.css' | asset_url | stylesheet_tag }}
<style>
body .elvo-pv__save,body .elvo-pv__flag,body .elvo-tier__flag,body .elvo-summary__save,body .elvo-hero-precio .hp-save{display:inline-block!important}
body .elvo-hero-precio s,body .elvo-summary s{display:inline!important}
body .elvo-pv__price s{display:block!important}
body .elvo-addon{display:none!important}
body .elvo-step:has(.elvo-models .elvo-model:only-child){display:none!important}
body .elvo-oferta{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:12px 0 0;padding:12px 16px;border-radius:14px;background:#050607;color:#fff;font-size:15px;line-height:1.3}
body .elvo-oferta b{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:700}
body .elvo-oferta .cd{margin-left:auto;font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:700;letter-spacing:.02em;background:#3355FF;border-radius:999px;padding:6px 12px;white-space:nowrap}
body .elvo-riesgo{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 0;padding:0;list-style:none}
body .elvo-riesgo li{font-size:13px;font-weight:500;padding:7px 12px;border:1px solid #BED0DF;border-radius:999px;background:#fff;color:#050607}
body .elvo-sticky{display:flex!important;gap:10px;align-items:center;justify-content:center}
body .elvo-sticky .elvo-cta{flex:1;margin:0!important;max-width:none!important}
body .elvo-sticky-wa{flex:none;width:52px;height:52px;border-radius:50%;background:#25D366;display:grid;place-items:center}
body .elvo-cano-opts{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;width:100%}
body .elvo-cano-opts a{font-size:14px;font-weight:500;padding:9px 14px;border:1px solid #3355FF;border-radius:999px;color:#3355FF!important;text-decoration:none!important;background:#fff}
body .elvo-cano-opts a:hover{background:#3355FF;color:#fff!important}
body .elvo-cano{flex-wrap:wrap}
#elvo-ayuda{position:fixed;left:16px;bottom:96px;z-index:60;max-width:300px;background:#050607;color:#fff;border-radius:18px;padding:16px 18px 18px;font-family:'Inter',Arial,sans-serif;font-size:14px;line-height:1.4;display:flex;flex-direction:column;gap:8px}
#elvo-ayuda b{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-size:16px}
#elvo-ayuda a{margin-top:4px;text-align:center;background:#3355FF;color:#fff!important;border-radius:999px;padding:11px 16px;font-weight:600;text-decoration:none!important}
#elvo-ayuda .x{position:absolute;top:6px;right:10px;background:none;border:0;color:#fff;font-size:20px;cursor:pointer;line-height:1}
body .elvo-wa-cta{display:block;text-align:center;margin-top:10px;padding:14px 18px;border:1px solid #3355FF;border-radius:999px;color:#3355FF!important;font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:17px;text-decoration:none!important;background:#fff}
body .elvo-wa-cta:hover{background:#3355FF;color:#fff!important}
</style>
<script>
(function(){
  var WA='51929190100';
  function plan(){
    var p=document.querySelector('.elvo-pv[aria-checked="true"]');
    return p?p.textContent.trim().replace(/\s+/g,' ').split('S/')[0].slice(0,32).trim():'';
  }

  var FIN=new Date('2026-10-24T23:59:59-05:00').getTime();
  function pad(n){return n<10?'0'+n:n}
  function addOferta(){
    if(document.getElementById('elvo-oferta'))return true;
    var ref=document.querySelector('.elvo-hero-precio');
    if(!ref)return false;
    var left=FIN-Date.now();
    var chips=document.createElement('ul');chips.className='elvo-riesgo';chips.id='elvo-riesgo';
    chips.innerHTML='<li>Envío gratis a todo el Perú</li><li>Pagas al recibir en Lima</li><li>30 días de prueba</li>';
    ref.insertAdjacentElement('afterend',chips);
    if(left>0){
      var o=document.createElement('div');o.className='elvo-oferta';o.id='elvo-oferta';
      o.innerHTML='<span><b>Precio de oferta</b> hasta el sábado 24 de octubre</span><span class="cd" id="elvo-cd"></span>';
      ref.insertAdjacentElement('afterend',o);
      var cd=document.getElementById('elvo-cd');
      (function tick(){var l=FIN-Date.now();if(l<=0){o.style.display='none';return}
        var d=Math.floor(l/864e5),h=Math.floor(l%864e5/36e5),m=Math.floor(l%36e5/6e4),s=Math.floor(l%6e4/1e3);
        cd.textContent=(d>0?d+'d ':'')+pad(h)+':'+pad(m)+':'+pad(s);setTimeout(tick,1000)})();
    }
    return true;
  }

  function waUrl(m){return 'https://wa.me/'+WA+'?text='+encodeURIComponent(m)}
  function stickyWA(){
    var st=document.querySelector('.elvo-sticky');
    if(!st)return false;
    if(st.querySelector('.elvo-sticky-wa'))return true;
    var a=document.createElement('a');a.className='elvo-sticky-wa';a.target='_blank';a.rel='noopener';a.setAttribute('aria-label','Escribir por WhatsApp');
    a.href=waUrl('Hola, quiero comprar elvo\u00b7 Nativo [WEB-STICKY]');
    a.innerHTML='<svg width="26" height="26" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.2 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .6l-.4.6c-.2.2-.3.4-.1.7.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l1.8.9c.3.1.4.2.5.3.1.2.1.8-.1 1.2z"/></svg>';
    st.appendChild(a);return true;
  }
  function canoOpts(){
    var c=document.querySelector('.elvo-cano');
    if(!c)return false;
    if(c.querySelector('.elvo-cano-opts'))return true;
    var d=document.createElement('div');d.className='elvo-cano-opts';
    [['Rosca','de rosca'],['Salida lisa','de salida lisa'],['Mezcladora o extra\u00edble','mezcladora o extra\u00edble'],['No s\u00e9','que no s\u00e9 c\u00f3mo es']].forEach(function(o){
      var a=document.createElement('a');a.target='_blank';a.rel='noopener';a.textContent=o[0];
      a.href=waUrl('Hola, mi ca\u00f1o es '+o[1]+'. \u00bfMe sirve elvo\u00b7 Nativo? Te env\u00edo una foto. [WEB-CANO]');
      d.appendChild(a);
    });
    c.appendChild(d);return true;
  }
  var ayudaShown=false;try{ayudaShown=!!sessionStorage.getItem('elvoAyuda')}catch(e){}
  function showAyuda(){
    if(ayudaShown||document.getElementById('elvo-ayuda'))return;
    ayudaShown=true;try{sessionStorage.setItem('elvoAyuda','1')}catch(e){}
    var d=document.createElement('div');d.id='elvo-ayuda';
    d.innerHTML='<button type="button" class="x" aria-label="Cerrar">\u00d7</button><b>\u00bfTe ayudo a elegir?</b><span>Cu\u00e9ntanos c\u00f3mo es tu ca\u00f1o y te recomendamos el equipo.</span><a target="_blank" rel="noopener" href="'+waUrl('Hola, necesito ayuda para elegir mi purificador elvo\u00b7 [WEB-AYUDA]')+'">Escribir por WhatsApp</a>';
    document.body.appendChild(d);
    d.querySelector('.x').addEventListener('click',function(){d.remove()});
  }
  var path=location.pathname;
  if(/^\/($|products\/|collections)/.test(path)){
    setTimeout(showAyuda,30000);
    document.addEventListener('mouseout',function(e){if(e.clientY<=0&&!e.relatedTarget)showAyuda()});
    document.addEventListener('click',function(e){if(e.target.closest&&e.target.closest('[data-elvo="cta"],.a-card form button'))ayudaShown=true},true);
  }
  document.addEventListener('click',function(e){
    var a=e.target.closest&&e.target.closest('a[href*="wa.me"]');if(!a)return;
    var m=decodeURIComponent(a.href).match(/\[([A-Z-]+)\]/);var code=m?m[1]:'WA';
    try{if(window.fbq)fbq('track','Contact',{content_name:code});}catch(x){}
    try{(window.dataLayer=window.dataLayer||[]).push({event:'whatsapp_click',wa_code:code});}catch(x){}
  },true);
  function add(){
    if(document.getElementById('elvo-wa-cta'))return true;
    var b=document.querySelector('.elvo [data-elvo="cta"]');
    if(!b)return false;
    var a=document.createElement('a');
    a.id='elvo-wa-cta';a.className='elvo-wa-cta';a.target='_blank';a.rel='noopener';
    a.textContent='Comprar por WhatsApp';
    function href(){var pl=plan();a.href='https://wa.me/'+WA+'?text='+encodeURIComponent('Hola, quiero comprar elvo· Nativo'+(pl?' ('+pl+')':'')+' [WEB-PDP]');}
    href();a.addEventListener('click',href);
    b.insertAdjacentElement('afterend',a);
    return true;
  }
  function planHint(){
    var l=document.querySelector('.elvo-pv-list');
    if(!l)return false;
    if(document.getElementById('elvo-planhint'))return true;
    var p=document.createElement('p');p.id='elvo-planhint';p.className='elvo-planhint';
    p.textContent='Pagas una sola vez y el purificador es tuyo. El plan solo cambia cu\u00e1ntos n\u00facleos de repuesto te llevas.';
    l.insertAdjacentElement('beforebegin',p);return true;
  }
  /* orden bajo la compra, de m\u00e1s a menos relevante */
  function orden(){
    var r=document.querySelector('.elvo[id^="elvo-pdp-"]');
    if(!r||!r.dataset.cierre)return false;
    var buy=r.querySelector('.elvo-buy'),an=buy&&buy.parentElement;
    if(!an)return true;
    ['[data-elvo-videos-lazy]','#instalacion','#caja','[id$="__llega"]','.elvo-faq','.elvo-quote','.elvo-rv'].forEach(function(s){
      var el=document.querySelector(s);if(!el)return;
      var nodo=r.contains(el)?el:(el.closest('.shopify-section')||el);
      if(nodo===an||nodo.contains(an))return;
      an.insertAdjacentElement('afterend',nodo);an=nodo;
    });
    return true;
  }
  /* carritos viejos: quita la propiedad "Regalo / l\u00e1mpara" de las l\u00edneas */
  var MAL=/regalo|l[a\u00e1]mpara/i,limp=0;
  function limpiaProps(){
    if(++limp>6)return;
    fetch('/cart.js',{headers:{Accept:'application/json'}}).then(function(r){return r.json()}).then(function(c){
      var idx=-1,np=null;
      (c.items||[]).some(function(it,i){
        var p=it.properties;if(!p)return false;
        var bad=Object.keys(p).filter(function(k){return k.charAt(0)!=='_'&&MAL.test(k+' '+p[k])});
        if(!bad.length)return false;
        idx=i;np={};Object.keys(p).forEach(function(k){np[k]=bad.indexOf(k)>-1?'':p[k]});
        if(!np._plan)np._plan='Plan con repuestos incluidos';return true;
      });
      if(idx<0)return;
      return fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({line:idx+1,properties:np})}).then(function(){
        try{if(window.ELVO&&ELVO.cart&&ELVO.cart.refresh)ELVO.cart.refresh()}catch(e){}
        limpiaProps();
      });
    }).catch(function(){});
  }
  function ocultaProps(){document.querySelectorAll('.elvo-cart__prop').forEach(function(e){if(MAL.test(e.textContent))e.style.display='none'})}
  limpiaProps();
  new MutationObserver(ocultaProps).observe(document.documentElement,{childList:true,subtree:true});
  var m=0,o=setInterval(function(){if(orden()||++m>80)clearInterval(o)},60);
  var n=0,t=setInterval(function(){var a=add(),b=addOferta(),c=stickyWA(),d=canoOpts(),e=planHint();if((a&&b&&c&&d&&e)||++n>40)clearInterval(t);},500);
})();
</script>
{% schema %}{"name":"elvo· Estilo global","settings":[]}{% endschema %}
