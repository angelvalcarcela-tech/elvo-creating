{%- assign foto2 = section.settings.imagen2 -%}
{%- assign parrafos = section.settings.texto | newline_to_br | split: '<br />' -%}
<style>
.fi{max-width:1440px;margin:0 auto;font-family:'Inter',Arial,sans-serif;color:#050607}
.fi__b{display:grid;grid-template-columns:1fr 1fr;gap:0;background:#fff}
.fi__bi{min-height:480px;background:radial-gradient(120% 90% at 30% 20%,#BED0DF 0%,#3355FF 55%,#010A21 100%);position:relative}
.fi__bi img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.fi__bt{padding:clamp(28px,6vw,96px);display:flex;flex-direction:column;justify-content:center;gap:16px}
.fi__bt h2{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:clamp(30.4px,3.6vw,48px);line-height:1.05;letter-spacing:-.01em;text-transform:uppercase;margin:0 0 6px}
.fi__bt p{margin:0;font-size:clamp(15.7px,1.25vw,17.6px);line-height:1.55;color:#2B3238;max-width:46ch}
.fi__tira{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-top:18px;padding-top:22px;border-top:1px solid #DCE6EE;max-width:46ch}
.fi__tira b{display:block;font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:6px}
.fi__tira span{font-size:13px;line-height:1.4;color:#4A5258}
.fi__sh{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:16.8px;color:#050607!important;margin-top:6px!important}
@media(max-width:800px){.fi__tira{grid-template-columns:1fr;gap:14px}.fi__b{grid-template-columns:1fr}.fi__bi{min-height:300px}.fi__bt{padding:32px 20px 44px}}
</style>
<section class="fi">
 <div class="fi__b">
  <div class="fi__bi">{%- if foto2 != blank -%}{{ foto2 | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.titulo2 }}{%- endif -%}</div>
  <div class="fi__bt">
   <h2>{{ section.settings.titulo2 }}</h2>
   {%- for p in parrafos -%}{%- if p != blank -%}<p>{{ p }}</p>{%- endif -%}{%- endfor -%}
   {%- if section.settings.esencia != blank or section.settings.promesa != blank or section.settings.principio != blank -%}
   <div class="fi__tira">
    <div><b>Esencia</b><span>{{ section.settings.esencia }}</span></div>
    <div><b>Promesa</b><span>{{ section.settings.promesa }}</span></div>
    <div><b>Principio</b><span>{{ section.settings.principio }}</span></div>
   </div>
   {%- endif -%}
  </div>
 </div>
</section>
{% schema %}
{"name": "elvo· Filosofía de marca", "settings": [{"type": "image_picker", "id": "imagen2", "label": "Foto del agua (detalle, textura)", "info": "Sin foto se muestra un degradado de agua."}, {"type": "text", "id": "titulo2", "label": "Título de filosofía", "default": "Agua, diseñada distinto."}, {"type": "text", "id": "esencia", "label": "Tira: esencia de marca"}, {"type": "text", "id": "promesa", "label": "Tira: promesa de marca"}, {"type": "text", "id": "principio", "label": "Tira: principio central"}, {"type": "textarea", "id": "texto", "label": "Texto (un párrafo por línea)", "default": "El agua es esencial. La tecnología que la cuida no tiene por qué sentirse complicada.\nelvo· trae diseño a la filtración doméstica: un objeto que se queda a la vista sobre tu mesada, un núcleo cuyo cambio te avisamos con tiempo y una promesa simple, decirte con exactitud qué hace cada equipo.\nCreemos que el agua es el primer ingrediente de todo lo que haces. Por eso la tratamos con calma y con cifras, no con alarmas."}], "presets": [{"name": "elvo· Filosofía de marca"}]}
{% endschema %}
