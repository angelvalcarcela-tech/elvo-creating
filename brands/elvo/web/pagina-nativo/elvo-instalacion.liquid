{%- liquid
  assign vid = section.settings.video
  assign url = section.settings.video_url
-%}
{%- if vid != blank or url != blank or request.design_mode -%}
<style>
.ei{max-width:1100px;margin:0 auto;padding:56px 20px;font-family:'Inter',Arial,sans-serif;color:#050607}
.ei h2{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:clamp(1.6rem,3vw,2.3rem);letter-spacing:-.02em;margin:0 0 20px}
.ei__g{display:grid;grid-template-columns:1.3fr 1fr;gap:32px;align-items:center}
.ei__v{border-radius:24px;overflow:hidden;background:#EEF3F7;aspect-ratio:16/9}
.ei__v video,.ei__v iframe{width:100%;height:100%;border:0;display:block;object-fit:cover}
.ei__ph{height:100%;display:grid;place-items:center;color:#5B6470;font-size:14px;text-align:center;padding:20px}
.ei ol{list-style:none;margin:0;padding:0;counter-reset:s}
.ei li{counter-increment:s;padding:14px 0 14px 46px;position:relative;border-bottom:1px solid #DCE6EE;font-size:16px;line-height:1.4}
.ei li::before{content:counter(s);position:absolute;left:0;top:12px;width:30px;height:30px;border-radius:50%;background:#3355FF;color:#fff;display:grid;place-items:center;font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:700;font-size:14px}
@media(max-width:760px){.ei__g{grid-template-columns:1fr}}
</style>
<section class="ei" id="instalacion">
  <h2>{{ section.settings.titulo }}</h2>
  <div class="ei__g">
    <div class="ei__v">
      {%- if vid != blank -%}
        {{ vid | video_tag: image_size: '1280x', controls: true, playsinline: true, preload: 'none' }}
      {%- elsif url != blank -%}
        {{ url | video_tag }}
      {%- else -%}
        <div class="ei__ph">Aquí va tu video de instalación. Súbelo en el editor del tema.</div>
      {%- endif -%}
    </div>
    <ol>
      {%- for b in section.blocks -%}<li {{ b.shopify_attributes }}>{{ b.settings.texto }}</li>{%- endfor -%}
    </ol>
  </div>
</section>
{%- endif -%}
{% schema %}
{"name":"elvo· Video instalación","settings":[
{"type":"text","id":"titulo","label":"Título","default":"Instalación en 5 minutos"},
{"type":"video","id":"video","label":"Video (subido a Shopify)"},
{"type":"video_url","id":"video_url","label":"o video de YouTube / Vimeo","accept":["youtube","vimeo"]}],
"blocks":[{"type":"paso","name":"Paso","settings":[{"type":"text","id":"texto","label":"Texto","default":"Paso"}]}],
"max_blocks":6,
"presets":[{"name":"elvo· Video instalación","blocks":[{"type":"paso","settings":{"texto":"Coloca el adaptador en la salida del caño."}},{"type":"paso","settings":{"texto":"Conecta el purificador."}},{"type":"paso","settings":{"texto":"Abre el agua y déjala correr unos minutos antes de usar."}}]}]}
{% endschema %}
