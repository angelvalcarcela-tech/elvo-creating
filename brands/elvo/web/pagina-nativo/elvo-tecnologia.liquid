{%- assign p = all_products['elvonativo'] -%}
{%- assign rep = all_products['repuesto-elvo-nativo'] -%}
{%- assign meses = '18,36,72' | split: ',' -%}
{%- assign nucleos = '1,2,4' | split: ',' -%}
{%- assign base = p.variants.first.price -%}
<style>
.et{max-width:1100px;margin:0 auto;padding:56px 20px;font-family:'Inter',Arial,sans-serif;color:#050607}
.et__k{font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:#3355FF}
.et h2{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:clamp(1.7rem,3vw,2.5rem);letter-spacing:-.02em;line-height:1.08;margin:10px 0 12px}
.et__lead{font-size:17px;line-height:1.5;color:#5B6470;max-width:60ch;margin:0 0 28px}
.et__g{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.et__box{background:#010A21;border-radius:24px;padding:26px;color:#fff}
.et__box h3,.et__pl h3{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:1.15rem;margin:0 0 14px}
.et ol{list-style:none;margin:0;padding:0;counter-reset:e}
.et li.st{counter-increment:e;display:grid;grid-template-columns:34px 1fr;gap:12px;padding:12px 0;border-top:1px solid rgba(190,208,223,.2)}
.et li.st:first-child{border-top:0}
.et li.st::before{content:counter(e);width:30px;height:30px;border-radius:50%;background:#3355FF;color:#fff;display:grid;place-items:center;font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:700;font-size:13px}
.et li.st b{display:block;font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:16px}
.et li.st span{font-size:14px;color:#BED0DF;line-height:1.4}
.et__pl{display:flex;flex-direction:column;gap:10px}
.et__plan{border:1px solid #DCE6EE;border-radius:18px;background:#fff;padding:16px 18px;display:grid;grid-template-columns:1fr auto;gap:2px 12px;align-items:baseline}
.et__plan b{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:700;font-size:1.05rem}
.et__plan .pr{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:700;font-size:1.3rem;text-align:right}
.et__plan small{font-size:13.5px;color:#5B6470;line-height:1.4}
.et__plan small.r{text-align:right}
.et__plan.is{border-color:#3355FF;box-shadow:0 0 0 1px #3355FF;background:#F2F5FF}
.et__note{font-size:13px;color:#5B6470;margin:4px 2px 0;line-height:1.45}
.et__chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}
.et__chips span{font-size:13.5px;font-weight:500;padding:9px 15px;border:1px solid #BED0DF;border-radius:999px;background:#fff}
.et__fine{font-size:12px;color:#6B7480;margin-top:18px;line-height:1.5}
@media(max-width:760px){.et__g{grid-template-columns:1fr}.et{padding:44px 16px}.et__box{padding:20px}}
</style>
<section class="et" id="tecnologia">
  <span class="et__k">{{ section.settings.etiqueta }}</span>
  <h2>{{ section.settings.titulo }}</h2>
  <p class="et__lead">{{ section.settings.bajada }}</p>
  <div class="et__g">
    <div class="et__box">
      <h3>{{ section.settings.titulo_etapas }}</h3>
      <ol>{%- for b in section.blocks -%}<li class="st" {{ b.shopify_attributes }}><div><b>{{ b.settings.nombre }}</b><span>{{ b.settings.texto }}</span></div></li>{%- endfor -%}</ol>
    </div>
    <div class="et__pl">
      <h3>{{ section.settings.titulo_planes }}</h3>
      {%- for v in p.variants -%}
        {%- assign i = forloop.index0 -%}
        {%- assign m = meses[i] | plus: 0 -%}
        {%- assign n = nucleos[i] | plus: 0 -%}
        {%- assign extra = n | minus: 1 -%}
        <div class="et__plan{% if i == 1 %} is{% endif %}">
          <b>{{ v.title }}</b><span class="pr">S/ {{ v.price | divided_by: 100 }}</span>
          <small>{{ n }} {% if n == 1 %}núcleo incluido{% else %}núcleos incluidos{% endif %}{% if extra > 0 %} · cada repuesto extra te sale a S/ {{ v.price | minus: base | divided_by: extra | divided_by: 100.0 | round }}{% endif %}</small>
          <small class="r">S/ {{ v.price | divided_by: 100.0 | divided_by: m | round: 2 }} al mes</small>
        </div>
      {%- endfor -%}
      {%- if rep.price > 0 -%}<p class="et__note">El núcleo suelto cuesta S/ {{ rep.price | divided_by: 100 }} y dura 18 meses de uso normal. Los planes de 3 y 6 años te lo dejan mucho más barato.</p>{%- endif -%}
    </div>
  </div>
  <div class="et__chips">{%- for c in section.settings.chips | split: ',' -%}<span>{{ c | strip }}</span>{%- endfor -%}</div>
  <p class="et__fine">{{ section.settings.legal }}</p>
</section>
{% schema %}
{"name":"elvo· Tecnología y precio","settings":[
{"type":"text","id":"etiqueta","label":"Etiqueta","default":"Tecnología"},
{"type":"text","id":"titulo","label":"Título","default":"Por qué vale lo que cuesta"},
{"type":"textarea","id":"bajada","label":"Bajada","default":"Un purificador con un núcleo de 6 etapas que lo instalas tú en 5 minutos, sin electricidad, sin obras y sin gasfitero."},
{"type":"text","id":"titulo_etapas","label":"Título de las etapas","default":"6 etapas en un solo núcleo"},
{"type":"text","id":"titulo_planes","label":"Título de los planes","default":"Lo que te llevas en cada plan"},
{"type":"text","id":"chips","label":"Garantías (separadas por coma)","default":"30 días de prueba, Garantía de 1 año, Si no encaja en tu caño te devolvemos tu dinero, Envío gratis a todo el Perú"},
{"type":"textarea","id":"legal","label":"Nota legal","default":"*Según la ficha técnica del núcleo PureCore. Los resultados dependen de la calidad del agua de entrada y del cambio oportuno del núcleo."}],
"blocks":[{"type":"etapa","name":"Etapa","settings":[{"type":"text","id":"nombre","label":"Nombre","default":"Etapa"},{"type":"text","id":"texto","label":"Texto","default":"Descripción"}]}],
"max_blocks":8,
"presets":[{"name":"elvo· Tecnología y precio","blocks":[
{"type":"etapa","settings":{"nombre":"Carbón activado","texto":"Reduce cloro, olores y sabores."}},
{"type":"etapa","settings":{"nombre":"KDF-F","texto":"Retiene plomo y metales pesados*."}},
{"type":"etapa","settings":{"nombre":"Nanotecnología","texto":"Etapa adicional del núcleo PureCore."}},
{"type":"etapa","settings":{"nombre":"Aluminosilicato sintético","texto":"Cuida la calidad del agua."}},
{"type":"etapa","settings":{"nombre":"Plata coloidal","texto":"Protege el núcleo por dentro."}},
{"type":"etapa","settings":{"nombre":"Plata iónica","texto":"Protege el núcleo por dentro."}}]}]}
{% endschema %}
