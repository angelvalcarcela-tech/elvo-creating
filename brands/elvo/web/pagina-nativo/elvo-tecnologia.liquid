{%- assign chips = section.settings.chips | split: ',' -%}
<style>
.et-bg{position:relative;overflow:hidden;background:#F9FAFB;isolation:isolate}
.et-bg::before,.et-bg::after{content:"";position:absolute;z-index:-1;pointer-events:none;background:repeating-linear-gradient(90deg,rgba(125,200,255,0) 0,rgba(110,195,255,.95) 46px,rgba(125,200,255,.05) 96px,rgba(110,195,255,.8) 150px,rgba(125,200,255,0) 200px);filter:blur(26px)}
.et-bg::before{top:-6%;left:-4%;width:72%;height:95%;-webkit-mask-image:radial-gradient(ellipse at 0 0,#000 22%,transparent 56%);mask-image:radial-gradient(ellipse at 0 0,#000 22%,transparent 56%)}
.et-bg::after{bottom:-6%;right:-4%;width:72%;height:95%;-webkit-mask-image:radial-gradient(ellipse at 100% 100%,#000 22%,transparent 56%);mask-image:radial-gradient(ellipse at 100% 100%,#000 22%,transparent 56%)}
@media(max-width:700px){.et-bg::before,.et-bg::after{width:80%;height:40%}}
.et{max-width:1100px;margin:0 auto;padding:72px 20px;font-family:'Inter',Arial,sans-serif;color:#050607;letter-spacing:0}
.et *{box-sizing:border-box;letter-spacing:0}
.et__k{font-size:12px;font-weight:500;letter-spacing:.14em!important;text-transform:uppercase;color:#3355FF}
.et h2{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:clamp(30.4px,3.2vw,44.8px);letter-spacing:-.02em!important;line-height:1.05;margin:10px 0 10px}
.et__lead{font-size:18px;line-height:1.5;color:#5B6470;max-width:52ch;margin:0 0 44px}
.et__lab{font-size:12px;font-weight:500;letter-spacing:.12em!important;text-transform:uppercase;color:#6B7480;margin:0 0 16px}
.et__pi{list-style:none;margin:0 0 56px;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:28px}
.et__pi li{border-top:2px solid #050607;padding-top:16px}
.et__pi b{display:block;font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:17.6px;line-height:1.25;margin-bottom:6px}
.et__pi span{display:block;font-size:15px;color:#5B6470;line-height:1.5}
.et__pl{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.et__plan{position:relative;border:1px solid #DCE6EE;border-radius:24px;background:#fff;padding:26px 24px}
.et__tag{position:absolute;top:-11px;left:24px;background:#3355FF;color:#fff;font-size:11.5px;font-weight:500;border-radius:999px;padding:3px 11px}
.et__plan b{display:block;font-size:12px;font-weight:500;letter-spacing:.12em!important;text-transform:uppercase;color:#3355FF}
.et__plan .pr{display:block;font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:700;font-size:25.6px;line-height:1.1;margin:6px 0 10px;letter-spacing:-.02em!important}
.et__plan small{display:block;font-size:14.5px;color:#2B3238;line-height:1.5}
.et__plan small.r{color:#6B7480}
.et__note{font-size:14px;color:#6B7480;margin:16px 0 0}
.et__cert{display:flex;flex-wrap:wrap;align-items:center;gap:8px 18px;margin-top:40px;padding-top:22px;border-top:1px solid #DCE6EE;font-size:14px;color:#2B3238}
.et__cert strong{font-weight:600}
.et__cert span{display:inline-flex;align-items:center;gap:7px}
.et__cert span::before{content:"\2713";color:#3355FF;font-weight:700}
.et__chips{margin-top:14px;font-size:13.5px;color:#6B7480}
.et__fine{font-size:12px;color:#6B7480;margin-top:12px;line-height:1.5;max-width:80ch}
@media(max-width:900px){.et__pi{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.et{padding:48px 16px}.et__lead{margin-bottom:32px}.et__pi{grid-template-columns:1fr;gap:20px;margin-bottom:40px}.et__pl{grid-template-columns:1fr}.et__plan{padding:22px 20px}}
</style>
<div class="et-bg"><section class="et" id="tecnologia">
  <span class="et__k">{{ section.settings.etiqueta }}</span>
  <h2>{{ section.settings.titulo }}</h2>
  <p class="et__lead">{{ section.settings.bajada_marca }}</p>
  <ul class="et__pi">
    {%- for i in (1..5) -%}
      {%- assign kt = 'p' | append: i | append: '_t' -%}
      {%- assign kx = 'p' | append: i | append: '_x' -%}
      {%- if section.settings[kt] != blank -%}<li><b>{{ section.settings[kt] }}</b><span>{{ section.settings[kx] }}</span></li>{%- endif -%}
    {%- endfor -%}
  </ul>
  <p class="et__lab">{{ section.settings.titulo_cert }}</p>
  <div class="et__pl">
    {%- for i in (1..3) -%}
      {%- assign kn = 'c' | append: i | append: '_n' -%}
      {%- assign kk = 'c' | append: i | append: '_k' -%}
      {%- assign kx = 'c' | append: i | append: '_x' -%}
      {%- if section.settings[kn] != blank -%}
      <div class="et__plan">
        <b>{{ section.settings[kk] }}</b><span class="pr">{{ section.settings[kn] }}</span>
        <small>{{ section.settings[kx] }}</small>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <p class="et__chips">{%- for c in chips -%}{{ c | strip }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}</p>
  <p class="et__fine">{{ section.settings.legal }}</p>
</section></div>
{% schema %}
{"name":"elvo· Tecnología y precio","settings":[{"type":"text","id":"etiqueta","label":"Etiqueta","default":"Tecnología"},{"type":"text","id":"titulo","label":"Título","default":"Por qué vale lo que cuesta"},{"type":"textarea","id":"bajada_marca","label":"Bajada","default":"Diseño, un núcleo por dentro y una marca que te acompaña."},{"type":"text","id":"titulo_pilares","label":"(Sin uso) Título de la caja","default":"Más que un filtro"},{"type":"text","id":"p1_t","label":"Punto 1: título","default":"Diseño que se queda a la vista"},{"type":"text","id":"p1_x","label":"Punto 1: texto","default":"Pensado para vivir sobre tu mesada."},{"type":"text","id":"p2_t","label":"Punto 2: título","default":"Filtración en un solo núcleo"},{"type":"text","id":"p2_x","label":"Punto 2: texto","default":"Toda la filtración, dentro de un núcleo fácil de cambiar."},{"type":"text","id":"p3_t","label":"Punto 3: título","default":"Te avisamos cuándo cambiarlo"},{"type":"text","id":"p3_x","label":"Punto 3: texto","default":"Un aviso por WhatsApp cuando toca renovarlo."},{"type":"text","id":"p4_t","label":"Punto 4: título","default":"Atención cercana"},{"type":"text","id":"p4_x","label":"Punto 4: texto","default":"Te acompañamos por WhatsApp antes y después de comprar."},{"type":"text","id":"p5_t","label":"Punto 5: título"},{"type":"text","id":"p5_x","label":"Punto 5: texto"},{"type":"text","id":"titulo_cert","label":"Título de las certificaciones","default":"Nuestras certificaciones"},{"type":"text","id":"c1_k","label":"Cert 1: etiqueta","default":"Membresía"},{"type":"text","id":"c1_n","label":"Cert 1: nombre","default":"Water Quality Association"},{"type":"textarea","id":"c1_x","label":"Cert 1: qué significa","default":"Asociación internacional de la industria del agua. Nuestro fabricante es miembro desde 2025 y se compromete con su código de ética."},{"type":"text","id":"c2_k","label":"Cert 2: etiqueta","default":"Calidad"},{"type":"text","id":"c2_n","label":"Cert 2: nombre","default":"ISO 9001:2015"},{"type":"textarea","id":"c2_x","label":"Cert 2: qué significa","default":"Norma internacional de gestión de calidad. Certifica que la fábrica controla y mejora de forma documentada cómo produce."},{"type":"text","id":"c3_k","label":"Cert 3: etiqueta","default":"Medio ambiente"},{"type":"text","id":"c3_n","label":"Cert 3: nombre","default":"ISO 14001:2015"},{"type":"textarea","id":"c3_x","label":"Cert 3: qué significa","default":"Norma internacional de gestión ambiental. Certifica que la fábrica gestiona y reduce su impacto sobre el medio ambiente."},{"type":"text","id":"chips","label":"Garantías (separadas por coma)","default":"Garantía de 1 año, 30 días de prueba, Envío gratis a todo el Perú"},{"type":"textarea","id":"legal","label":"Nota legal","default":"*Según la ficha técnica del núcleo PureCore. Los resultados dependen de la calidad del agua de entrada y del cambio oportuno del núcleo."}],"blocks":[{"type":"etapa","name":"Etapa","settings":[{"type":"text","id":"nombre","label":"Nombre","default":"Etapa"},{"type":"text","id":"texto","label":"Texto","default":"Descripción"}]},{"type":"cert","name":"Certificación","settings":[{"type":"text","id":"nombre","label":"Nombre (ej. ISO 9001, WQA)"},{"type":"text","id":"texto","label":"Qué certifica y para qué producto"}]}],"max_blocks":12,"presets":[{"name":"elvo· Tecnología y precio","blocks":[{"type":"etapa","settings":{"nombre":"Carbón activado","texto":"Reduce cloro, olores y sabores."}},{"type":"etapa","settings":{"nombre":"KDF-F","texto":"Retiene plomo y metales pesados*."}},{"type":"etapa","settings":{"nombre":"Nanotecnología","texto":"Etapa adicional del núcleo PureCore."}},{"type":"etapa","settings":{"nombre":"Aluminosilicato sintético","texto":"Cuida la calidad del agua."}},{"type":"etapa","settings":{"nombre":"Plata coloidal","texto":"Protege el núcleo por dentro."}},{"type":"etapa","settings":{"nombre":"Plata iónica","texto":"Protege el núcleo por dentro."}}]}]}
{% endschema %}
