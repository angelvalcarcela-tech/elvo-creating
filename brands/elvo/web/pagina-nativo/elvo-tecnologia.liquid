{%- assign chips = section.settings.chips | split: ',' -%}
<style>
.et-bg{position:relative;overflow:hidden;background:#F1F4F8;isolation:isolate}
.et-bg::before,.et-bg::after{content:"";position:absolute;z-index:-1;pointer-events:none;background:repeating-linear-gradient(90deg,rgba(125,200,255,0) 0,rgba(110,195,255,.95) 46px,rgba(125,200,255,.05) 96px,rgba(110,195,255,.8) 150px,rgba(125,200,255,0) 200px);filter:blur(26px)}
.et-bg::before{top:-6%;left:-4%;width:72%;height:95%;-webkit-mask-image:radial-gradient(ellipse at 0 0,#000 22%,transparent 56%);mask-image:radial-gradient(ellipse at 0 0,#000 22%,transparent 56%)}
.et-bg::after{bottom:-6%;right:-4%;width:72%;height:95%;-webkit-mask-image:radial-gradient(ellipse at 100% 100%,#000 22%,transparent 56%);mask-image:radial-gradient(ellipse at 100% 100%,#000 22%,transparent 56%)}
@media(max-width:700px){.et-bg::before,.et-bg::after{width:80%;height:40%}}
.et{max-width:1100px;margin:0 auto;padding:72px 20px 56px;font-family:'Inter',Arial,sans-serif;color:#050607;letter-spacing:0}
.et *{box-sizing:border-box;letter-spacing:0}
.et__k{font-size:12px;font-weight:500;letter-spacing:.14em!important;text-transform:uppercase;color:#3355FF}
.et h2{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:clamp(32px,4.6vw,56px);letter-spacing:-.025em!important;line-height:1.06;margin:10px 0 12px;max-width:16ch}
.et__lead{font-size:18px;line-height:1.5;color:#5B6470;max-width:48ch;margin:0 0 34px}
.et__lab{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:clamp(22px,2.4vw,30px);letter-spacing:-.015em!important;margin:46px 0 16px}
.et__rail{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;margin:0 -20px;padding:4px 20px 8px;scroll-padding:0 20px}
.et__rail::-webkit-scrollbar{display:none}
.et__card{--c:#3355FF;flex:0 0 300px;scroll-snap-align:start;background:#fff;border-radius:28px;padding:26px 26px 22px;min-height:250px;display:flex;flex-direction:column}
.et__ic{width:46px;height:46px;display:block;color:var(--c)}
.et__ic svg{width:100%;height:100%;display:block}
.et__card h3{font-family:'Plus Jakarta Sans',Arial,sans-serif;font-weight:600;font-size:24px;line-height:1.22;letter-spacing:-.015em!important;margin:30px 0 0;color:#050607}
.et__card h3 em{font-style:normal;color:var(--c)}
.et__card .et__e{font-size:12px;font-weight:500;letter-spacing:.12em!important;text-transform:uppercase;color:#6B7480;margin:26px 0 0}
.et__list{list-style:none;margin:14px 0 0;padding:0;font-size:14.5px;line-height:1.35;color:#2B3238}
.et__list li{padding:5px 0}
.et__list b{font-weight:600;color:#050607}
.et__more p+p{margin-top:8px}
.et__card--k .et__more{font-size:14px}
.et__more{margin-top:16px;font-size:15.5px;line-height:1.5;color:#2B3238}
.et__more[hidden]{display:none}
.et__more p{margin:0}
.et__plus{margin-top:auto;align-self:flex-end;width:44px;height:44px;border-radius:50%;border:0;background:#E8E8ED;color:#1D1D1F;cursor:pointer;display:grid;place-items:center;padding:0;transition:transform .2s,background .2s}
.et__plus svg{width:18px;height:18px}
.et__card.is-open .et__plus{transform:rotate(45deg);background:#050607;color:#fff}
.et__nav{display:flex;justify-content:flex-end;gap:12px;margin-top:12px}
.et__nav button{width:44px;height:44px;border-radius:50%;border:0;background:rgba(210,210,215,.6);color:#1D1D1F;cursor:pointer;display:grid;place-items:center;padding:0}
.et__nav button:disabled{opacity:.4;cursor:default}
.et__nav button:not(:disabled):hover{background:#D2D2D7}
.et__nav svg{width:18px;height:18px}
.et__chips{margin-top:26px;font-size:13.5px;color:#6B7480}
.et__fine{font-size:12px;color:#6B7480;margin-top:12px;line-height:1.5;max-width:80ch}
@media(max-width:700px){.et{padding:48px 16px 40px}.et__lead{font-size:16.5px;margin-bottom:24px}.et__rail{margin:0 -16px;padding:4px 16px 8px;scroll-padding:0 16px}.et__card{flex-basis:78%;min-height:210px;padding:22px 20px 18px}.et__card h3{font-size:22px}.et__lab{margin-top:34px}}
</style>
<div class="et-bg"><section class="et" id="tecnologia">
  <span class="et__k">{{ section.settings.etiqueta }}</span>
  <h2>{{ section.settings.titulo }}</h2>
  <p class="et__lead">{{ section.settings.bajada_marca }}</p>
  <div data-rail>
   <div class="et__rail">
    {%- assign cols = '#3355FF,#8B5CF6,#F2680C,#0E9F8E,#D9467E' | split: ',' -%}
    {%- for i in (1..3) -%}
     {%- assign kt = 'p' | append: i | append: '_t' -%}{%- assign kx = 'p' | append: i | append: '_x' -%}
     {%- if section.settings[kt] != blank -%}
     {%- assign tt = section.settings[kt] -%}
     {%- liquid
  assign html = ''
  if tt contains '*'
    assign parts = tt | split: '*'
    for pt in parts
      assign odd = forloop.index0 | modulo: 2
      if odd == 1
        assign html = html | append: '<em>' | append: pt | append: '</em>'
      else
        assign html = html | append: pt
      endif
    endfor
  else
    assign pl = ''
    assign hl = ''
    assign words = tt | split: ' '
    assign cut = words.size | divided_by: 2
    for w in words
      if forloop.index0 < cut
        assign pl = pl | append: w | append: ' '
      else
        assign hl = hl | append: w | append: ' '
      endif
    endfor
    assign html = pl | append: '<em>' | append: hl | append: '</em>'
  endif
-%}
     <article class="et__card" style="--c:{{ cols[forloop.index0] }}"><span class="et__ic">
      {%- case i -%}{%- when 1 -%}<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="17"/><path d="M24 14v20M19 19c0-2 2-3 5-3s5 1 5 3-2 3-5 3-5 1-5 3 2 3 5 3 5-1 5-3"/></svg>{%- when 2 -%}<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 5c7 9 12 15 12 21a12 12 0 0 1-24 0c0-6 5-12 12-21z"/><path d="M18 28a6 6 0 0 0 6 6"/></svg>{%- else -%}<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="17"/><path d="M24 14v10l7 4"/></svg>{%- endcase -%}
     </span><h3>{{ html }}</h3>{%- if section.settings[kx] != blank -%}<div class="et__more" hidden><p>{{ section.settings[kx] }}</p></div><button type="button" class="et__plus" aria-expanded="false" aria-label="Ver más"><svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 2v14M2 9h14"/></svg></button>{%- endif -%}</article>
     {%- endif -%}
    {%- endfor -%}
    <article class="et__card et__card--k" style="--c:#0E9F8E"><span class="et__ic"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 4l16 6v12c0 10-6.5 18-16 22C14.5 40 8 32 8 22V10z"/><path d="M16 24l6 6 11-12"/></svg></span><h3><em>{{ section.settings.titulo_cert }}</em></h3><div class="et__more" hidden><ul class="et__list">{%- for i in (1..3) -%}{%- assign kn = 'c' | append: i | append: '_n' -%}{%- assign kk = 'c' | append: i | append: '_k' -%}{%- if section.settings[kn] != blank -%}<li><b>{{ section.settings[kn] }}</b> · {{ section.settings[kk] }}</li>{%- endif -%}{%- endfor -%}</ul><p>{{ section.settings.cert_texto }}</p></div><button type="button" class="et__plus" aria-expanded="false" aria-label="Ver más"><svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 2v14M2 9h14"/></svg></button></article>
   </div>
   <div class="et__nav"><button type="button" data-p aria-label="Anterior"><svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.5 3l-6 6 6 6"/></svg></button><button type="button" data-n aria-label="Siguiente"><svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3l6 6-6 6"/></svg></button></div>
  </div>
  <p class="et__chips">{%- for c in chips -%}{{ c | strip }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}</p>
  <p class="et__fine">{{ section.settings.legal }}</p>
</section></div>
<script>
(function(){
  var root=document.getElementById('tecnologia');if(!root)return;
  root.querySelectorAll('.et__plus').forEach(function(b){b.addEventListener('click',function(){
    var c=b.closest('.et__card'),m=c.querySelector('.et__more'),o=b.getAttribute('aria-expanded')==='true';
    b.setAttribute('aria-expanded',o?'false':'true');m.hidden=o;c.classList.toggle('is-open',!o);
  })});
  root.querySelectorAll('[data-rail]').forEach(function(w){
    var r=w.querySelector('.et__rail'),p=w.querySelector('[data-p]'),n=w.querySelector('[data-n]'),nav=w.querySelector('.et__nav');
    function st(){var m=r.scrollWidth-r.clientWidth;nav.style.display=m>6?'flex':'none';p.disabled=r.scrollLeft<=4;n.disabled=r.scrollLeft>=m-4}
    function go(d){var c=r.querySelector('.et__card');r.scrollBy({left:d*(c.offsetWidth+16),behavior:'smooth'})}
    p.addEventListener('click',function(){go(-1)});n.addEventListener('click',function(){go(1)});
    r.addEventListener('scroll',st,{passive:true});window.addEventListener('resize',st);st();
  });
})();
</script>
{% schema %}
{"name":"elvo· Tecnología y precio","settings":[{"type":"text","id":"etiqueta","label":"Etiqueta","default":"Tecnología"},{"type":"text","id":"titulo","label":"Título","default":"Lo que ganas con elvo·"},{"type":"textarea","id":"bajada_marca","label":"Bajada","default":"Comodidad, ahorro, mejor sabor y tranquilidad en cada vaso."},{"type":"text","id":"titulo_pilares","label":"(Sin uso) Título de la caja","default":"Más que un filtro"},{"type":"text","id":"p1_t","label":"Punto 1: título","default":"*Ahorras en bidones* y botellas"},{"type":"text","id":"p1_x","label":"Punto 1: texto","default":"Compras menos agua envasada: ahorras dinero, generas menos pl\u00e1stico y ganas espacio en casa."},{"type":"text","id":"p2_t","label":"Punto 2: título","default":"Agua *m\u00e1s rica*, sin sabor a cloro"},{"type":"text","id":"p2_x","label":"Punto 2: texto","default":"Reduce cloro, olores y sabores, para que d\u00e9 gusto tomarla todos los d\u00edas."},{"type":"text","id":"p3_t","label":"Punto 3: título","default":"*Agua lista* sin salir a comprar"},{"type":"text","id":"p3_x","label":"Punto 3: texto","default":"Agua filtrada en casa cuando la quieras: sin cargar botellas ni quedarte sin agua para beber. Se instala en 5 minutos, sin gasfitero."},{"type":"text","id":"p4_t","label":"Punto 4: título","default":"Un objeto que *luce en tu mesada*"},{"type":"text","id":"p4_x","label":"Punto 4: texto","default":"Diseño pensado para vivir a la vista, no escondido bajo el lavadero."},{"type":"text","id":"p5_t","label":"Punto 5: título","default":"*Compras sin riesgo*"},{"type":"text","id":"p5_x","label":"Punto 5: texto","default":"30 días de prueba, envío gratis a todo el Perú y atención por WhatsApp. Te avisamos cuándo cambiar tu núcleo."},{"type":"text","id":"titulo_cert","label":"Título de las certificaciones","default":"Nuestras certificaciones"},{"type":"textarea","id":"cert_texto","label":"Tarjeta 4: texto al tocar +","default":"Tranquilidad al tomar agua todos los d\u00edas: purificadores fabricados bajo est\u00e1ndares internacionales de calidad."},{"type":"text","id":"c1_k","label":"Cert 1: etiqueta","default":"Membresía"},{"type":"text","id":"c1_n","label":"Cert 1: nombre","default":"Water Quality Association"},{"type":"text","id":"c2_k","label":"Cert 2: etiqueta","default":"Calidad"},{"type":"text","id":"c2_n","label":"Cert 2: nombre","default":"ISO 9001:2015"},{"type":"text","id":"c3_k","label":"Cert 3: etiqueta","default":"Medio ambiente"},{"type":"text","id":"c3_n","label":"Cert 3: nombre","default":"ISO 14001:2015"},{"type":"text","id":"chips","label":"Garantías (separadas por coma)","default":"Garantía de 1 año, 30 días de prueba, Envío gratis a todo el Perú"},{"type":"textarea","id":"legal","label":"Nota legal","default":"*Según la ficha técnica del núcleo PureCore. Los resultados dependen de la calidad del agua de entrada y del cambio oportuno del núcleo."}],"blocks":[{"type":"etapa","name":"Etapa","settings":[{"type":"text","id":"nombre","label":"Nombre","default":"Etapa"},{"type":"text","id":"texto","label":"Texto","default":"Descripción"}]},{"type":"cert","name":"Certificación","settings":[{"type":"text","id":"nombre","label":"Nombre (ej. ISO 9001, WQA)"},{"type":"text","id":"texto","label":"Qué certifica y para qué producto"}]}],"max_blocks":12,"presets":[{"name":"elvo· Tecnología y precio","blocks":[{"type":"etapa","settings":{"nombre":"Carbón activado","texto":"Reduce cloro, olores y sabores."}},{"type":"etapa","settings":{"nombre":"KDF-F","texto":"Retiene plomo y metales pesados*."}},{"type":"etapa","settings":{"nombre":"Nanotecnología","texto":"Etapa adicional del núcleo PureCore."}},{"type":"etapa","settings":{"nombre":"Aluminosilicato sintético","texto":"Cuida la calidad del agua."}},{"type":"etapa","settings":{"nombre":"Plata coloidal","texto":"Protege el núcleo por dentro."}},{"type":"etapa","settings":{"nombre":"Plata iónica","texto":"Protege el núcleo por dentro."}}]}]}
{% endschema %}
